# Copy to .env.agent.local (ignored by Git); do not put keys in this example.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_TYPE=responses
# DeepSeek: BASE_URL=https://api.deepseek.com, API_TYPE=chat_completions, MODEL=deepseek-v4-flash
# GLM: BASE_URL=https://open.bigmodel.cn/api/paas/v4, API_TYPE=chat_completions, MODEL=glm-4.7
# OPENAI_API_KEY must be the selected provider's key (variable name is shared).
# shadow writes candidate analysis only; official report continues to show rules.
RETAIL_AGENT_MODE=shadow
RETAIL_AGENT_MAX_NEW_POSTS=120
